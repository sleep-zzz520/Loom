{
  "name": "personal-workbench-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5174 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5174 electron .\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "self-test": "cross-env WORKBENCH_SELF_TEST=1 node electron/workspace.cjs",
    "store-self-test": "cross-env WORKBENCH_STORE_SELF_TEST=1 node electron/store.cjs",
    "today-self-test": "cross-env WORKBENCH_TODAY_SELF_TEST=1 node electron/today.cjs",
    "weekly-self-test": "cross-env WORKBENCH_WEEKLY_SELF_TEST=1 node electron/weekly.cjs",
    "quick-capture-self-test": "node --experimental-strip-types electron/quick-capture-self-test.cjs",
    "notifier-self-test": "cross-env WORKBENCH_NOTIFIER_SELF_TEST=1 node electron/notifier.cjs",
    "agent-self-test": "cross-env WORKBENCH_AGENT_SELF_TEST=1 node electron/agent.cjs",
    "agent-state-self-test": "cross-env WORKBENCH_AGENT_STATE_SELF_TEST=1 node electron/agent-state.cjs",
    "agent-music-self-test": "node electron/agent-music-self-test.cjs",
    "agent-format-self-test": "node --experimental-strip-types electron/agent-message-format-self-test.cjs",
    "agent-conversation-title-self-test": "node --experimental-strip-types electron/agent-conversation-title-self-test.cjs",
    "profile-avatar-self-test": "node --experimental-strip-types electron/profile-avatar-self-test.cjs",
    "music-shortcuts-self-test": "node --experimental-strip-types electron/music-shortcuts-self-test.cjs",
    "music-playback-state-self-test": "node --experimental-strip-types electron/music-playback-state-self-test.cjs",
    "music-lyrics-self-test": "node --experimental-strip-types electron/music-lyrics-self-test.cjs",
    "music-theme-self-test": "node --experimental-strip-types electron/music-theme-self-test.cjs",
    "music-self-test": "node electron/music-self-test.cjs",
    "mail-self-test": "cross-env WORKBENCH_MAIL_SELF_TEST=1 node electron/mail.cjs",
    "music-service-self-test": "cross-env WORKBENCH_MUSIC_SERVICE_SELF_TEST=1 node electron/music-service.cjs",
    "proactive-self-test": "cross-env WORKBENCH_PROACTIVE_SELF_TEST=1 node electron/proactive.cjs",
    "test": "npm run build && npm run self-test && npm run store-self-test && npm run today-self-test && npm run weekly-self-test && npm run quick-capture-self-test && npm run mail-self-test && npm run notifier-self-test && npm run agent-self-test && npm run agent-state-self-test && npm run agent-music-self-test && npm run agent-conversation-title-self-test && npm run profile-avatar-self-test && npm run music-shortcuts-self-test && npm run music-playback-state-self-test && npm run music-lyrics-self-test && npm run music-theme-self-test && npm run music-self-test && npm run music-service-self-test && npm run proactive-self-test"
  },
  "dependencies": {
    "dompurify": "^3.4.14",
    "imapflow": "^1.7.2",
    "lucide-react": "^0.454.0",
    "mailparser": "^3.9.15",
    "NeteaseCloudMusicApi": "4.32.0",
    "nodemailer": "^9.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^37.2.0",
    "typescript": "^5.6.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  }
}
